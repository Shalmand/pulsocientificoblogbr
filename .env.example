# O Lovable Cloud preenche estas duas sozinho quando o backend é ligado.
# São públicas por natureza (vão para o navegador) e não dão acesso a nada além do que o RLS permite.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Domínio do site, usado no canonical e no Open Graph
VITE_SITE_URL=https://pulsocientifico.com.br

# As chaves secretas (Pexels, Pixabay, Unsplash, AGENTE_CHAVE, PULSO_ADMIN_KEY, NASA...) NÃO entram
# aqui: ficam só em Lovable Cloud → Secrets, e só as funções do servidor as leem.

# Opcional: Google Analytics 4 (G-XXXXXXXXXX). Só carrega para quem aceitar "Estatísticas" nos cookies.
VITE_GA_ID=
